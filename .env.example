BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789
ADMIN_NAME=Botirali Turdiyev
ADMIN_URL=@glavniy_nazoratchi
REQUIRED_CHANNEL=@your_channel_username
CHANNEL_ID=-1001234567890

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=murojat_bot

# Optional: MFY admins fallback file
# REGION_LEADERS_ENV_PATH=region_leaders.env
# Agar true bo'lsa, bir adminni bir nechta MFYga biriktirishga ruxsat beradi.
ALLOW_SHARED_REGION_ADMINS=false

# FSM storage:
# auto   -> Vercel'da MongoDB, localda MemoryStorage
# memory -> hamma joyda MemoryStorage
# mongo  -> hamma joyda MongoDB
FSM_STORAGE_BACKEND=auto
FSM_MONGO_DB_NAME=murojat_bot_fsm
FSM_MONGO_COLLECTION_NAME=states_and_data

# Webhook settings (Vercel / serverless mode)
WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_URL ni odatda bo'sh qoldiring. Bo'sh bo'lsa /setup-webhook endpoint o'zi hisoblaydi.
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=replace_with_long_random_string
WEBHOOK_SETUP_TOKEN=replace_with_admin_setup_token

# ADMIN_ID glavniy boshliq hisoblanadi va barcha MFY murojaatlarini ko'radi.
# Har bir MFY uchun format:
# MFY_ADMIN_<MFY_NOMI>=TELEGRAM_ID | @username

# Azlartepa
MFY_ADMIN_AZLARTEPA=111111111 | @azlartepa_admin
# Badaxshon
MFY_ADMIN_BADAXSHON=222222222 | @badaxshon_admin
# Boburtepa
MFY_ADMIN_BOBURTEPA=333333333 | @boburtepa_admin
